<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/clipboard_history_pinned_first"
            android:layout_width="@dimen/config_clipboard_pinned_icon_size"
            android:layout_height="@dimen/config_clipboard_pinned_icon_size"
            android:layout_marginVertical="8dp"
            android:layout_marginStart="4dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="8dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/clipboard_entry_image_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/clipboard_entry_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="4"/>

        <TextView
            android:id="@+id/clipboard_entry_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:alpha="0.65"/>
    </LinearLayout>

    <TextView
        android:id="@+id/clipboard_entry_delete"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="×"
        android:textSize="22sp"
        android:alpha="0.75"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Удалить запись"
        tools:ignore="HardcodedText" />

</LinearLayout>
